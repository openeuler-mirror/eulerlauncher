<domain type="hvf">
  <name></name>
  <cpu mode="host-passthrough"/>
  <vcpu></vcpu>
  <memory unit="MiB"></memory>
  <os firmware="efi">
    <type arch="aarch64" machine="virt">hvm</type>
  </os>

  <devices>

    <emulator></emulator>

    <disk type="file" device="disk">
      <driver name="qemu" type="qcow2"/>
      <source file=""/>
      <target dev="sda" bus="virtio"/>
    </disk>

    <interface type='user'>
      <mac address=''/>
      <model type='virtio'/>
    </interface>

    <console type="pty">
      <target type="virtio" port="0"/>
      <alias name="console0"/>
    </console>

  </devices>
</domain>
